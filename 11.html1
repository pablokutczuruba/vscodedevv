            color: blueviolet;
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
            border: 5px solid #215dbd;
            padding: 16px;
        }

        main{
            background-color: rgb(104, 229, 88);
            color: rgb(230, 193, 190);
            max-width: 800px;
            margin: 0 auto;
            border: 5px solid #70cb2b;
            padding: 16px;
        }

        img{
            height: 250px;
            width: 250px;
        }
    </style>
</head>

<body>

    <header>
        <h1>Trabalho de Educação Digital sobre pcs</h1>
